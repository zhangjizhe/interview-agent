generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Plan {
  id String @id
  name String
  monthlyInterviews Int
  monthlyLlmCalls Int
  maxInputBytes Int
  maxOutputTokens Int
  organizations Organization[]
  @@map("plans")
}

model Organization {
  planId String @default("free")
  plan Plan @relation(fields: [planId], references: [id], onDelete: Restrict)
  quotaRevision Int @default(0)
  id String @id @default(cuid())
  name String
  createdAt DateTime @default(now())
  userRecords User[]
  labDatasetRecords LabDataset[]
  labAgentVersionRecords LabAgentVersion[]
  labRunRecords LabRun[]
  labRecordedImportRecords LabRecordedImport[]
  labFailureRecords LabFailure[]
  labExperimentRecords LabExperiment[]
  labExperimentRunRecords LabExperimentRun[]
  labReleaseDecisionRecords LabReleaseDecision[]
  labOperationLogRecords LabOperationLog[]
  workspaceRecords Workspace[]
  workspaceMemberRecords WorkspaceMember[]
  agentRecords Agent[]
  agentVersionRecords AgentVersion[]
  runRecords Run[]
  traceEventRecords TraceEvent[]
  decisionRecordRecords DecisionRecord[]
  factAssertionRecords FactAssertion[]
  decisionEvidenceRecords DecisionEvidence[]
  applicationRecords Application[]
  applicationRunRecords ApplicationRun[]
  toolApprovalRecords ToolApproval[]
  evaluationDatasetRecords EvaluationDataset[]
  evaluationCaseRecords EvaluationCase[]
  evaluatorRecords Evaluator[]
  agentEvaluationRunRecords AgentEvaluationRun[]
  evaluationResultRecords EvaluationResult[]
  interviewRecords Interview[]
  sessionCostRecords SessionCost[]
  usageLedgerRecords UsageLedger[]
  messageRecords Message[]
  reportRecords Report[]
  userToolPreferenceRecords UserToolPreference[]
  interviewTaskRecords InterviewTask[]
  answerHistoryRecords AnswerHistory[]
  targetJobRecords TargetJob[]
  jobSkillRequirementRecords JobSkillRequirement[]
  interviewQuestionRecords InterviewQuestion[]
  interviewAnswerRecords InterviewAnswer[]
  evaluationRunRecords EvaluationRun[]
  assessmentEvidenceRecords AssessmentEvidence[]
  candidateSkillStateRecords CandidateSkillState[]
  trainingRecommendationRecords TrainingRecommendation[]
  trainingAttemptRecords TrainingAttempt[]
  reflectionLogRecords ReflectionLog[]
  @@map("organizations")
}

model User {
  organizationId String @default("default-organization")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  @@index([organizationId])
  @@unique([id, organizationId])
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  passwordHash String?
  role      UserRole @default(USER)
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  interviews      Interview[]
  reflectionLogs  ReflectionLog[]
  targetJobs      TargetJob[]
  candidateSkillStates CandidateSkillState[]
  trainingRecommendations TrainingRecommendation[]
  trainingAttempts TrainingAttempt[]
  usageLedgerEntries UsageLedger[]
  ownedWorkspaces Workspace[]       @relation("WorkspaceOwner")
  workspaceMembers WorkspaceMember[]

  @@map("users")
}

model LabDataset {
  organizationId String @default("default-organization")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  @@index([organizationId])
  @@unique([id, organizationId])
  id             String          @id @default(cuid())
  version        String          @unique
  name           String
  sourceHash     String
  caseCount      Int
  responseCount  Int
  validationStatus LabValidationStatus
  createdAt      DateTime        @default(now())
  runs           LabRun[]
  experiments    LabExperiment[]
  releaseDecisions LabReleaseDecision[]

  @@index([validationStatus, createdAt])
  @@map("lab_datasets")
}

model LabAgentVersion {
  organizationId String @default("default-organization")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  @@index([organizationId])
  @@unique([id, organizationId])
  id                 String          @id @default(cuid())
  agentKey           String
  version            String
  runtimeVersion     String
  promptVersion      String?
  modelProvider      String?
  modelVersion       String?
  toolPolicyVersion  String?
  createdAt          DateTime        @default(now())
  runs               LabRun[]
  controlExperiments LabExperiment[] @relation("LabExperimentControl")
  treatmentExperiments LabExperiment[] @relation("LabExperimentTreatment")
  releaseDecisions   LabReleaseDecision[]

  @@unique([agentKey, version])
  @@index([agentKey, createdAt])
  @@map("lab_agent_versions")
}

model LabRun {
  organizationId String @default("default-organization")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  @@index([organizationId])
  @@unique([id, organizationId])
  id                    String          @id @default(cuid())
  agentVersionId        String
  agentVersion          LabAgentVersion @relation(fields: [agentVersionId], references: [id], onDelete: Restrict)
  datasetId             String
  dataset               LabDataset      @relation(fields: [datasetId], references: [id], onDelete: Restrict)
  runType               LabRunType
  status                LabRunStatus    @default(PENDING)
  traceRef              String?
  inputHash             String
  metrics               Json
  traceSummary          Json
  startedAt             DateTime        @default(now())
  completedAt           DateTime?
  durationMs            Int?
  inputTokens           Int             @default(0)
  outputTokens          Int             @default(0)
  estimatedCostCny      Float           @default(0)
  failures              LabFailure[]
  experiments           LabExperimentRun[]
  releaseDecisions     LabReleaseDecision[]
  recordedImport       LabRecordedImport?

  @@index([datasetId, startedAt])
  @@index([agentVersionId, startedAt])
  @@index([status, startedAt])
  @@map("lab_runs")
}

model LabRecordedImport {
  organizationId String @default("default-organization")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  @@index([organizationId])
  @@unique([id, organizationId])
  id              String          @id @default(cuid())
  receiptHash     String          @unique
  status          LabRecordedImportStatus @default(PENDING)
  recordedRun     Json
  submittedBy     String
  importedBy      String?
  runId           String?         @unique
  run             LabRun?         @relation(fields: [runId], references: [id], onDelete: SetNull)
  error           String?         @db.Text
  createdAt       DateTime        @default(now())
  importedAt      DateTime?

  @@index([status, createdAt])
  @@map("lab_recorded_imports")
}

model LabFailure {
  organizationId String @default("default-organization")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  @@index([organizationId])
  @@unique([id, organizationId])
  id              String       @id @default(cuid())
  runId           String
  run             LabRun       @relation(fields: [runId], references: [id], onDelete: Cascade)
  caseId          String
  category        LabFailureCategory
  severity        LabFailureSeverity
  evidenceSummary String?
  createdAt       DateTime     @default(now())

  @@index([runId, severity])
  @@index([category, createdAt])
  @@map("lab_failures")
}

model LabExperiment {
  organizationId String @default("default-organization")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  @@index([organizationId])
  @@unique([id, organizationId])
  id                 String          @id @default(cuid())
  name               String
  hypothesis         String
  controlVersionId   String
  controlVersion     LabAgentVersion @relation("LabExperimentControl", fields: [controlVersionId], references: [id], onDelete: Restrict)
  treatmentVersionId String
  treatmentVersion   LabAgentVersion @relation("LabExperimentTreatment", fields: [treatmentVersionId], references: [id], onDelete: Restrict)
  datasetId          String
  dataset            LabDataset      @relation(fields: [datasetId], references: [id], onDelete: Restrict)
  status             LabExperimentStatus @default(DRAFT)
  comparison        Json?
  createdBy         String
  createdAt          DateTime        @default(now())
  completedAt       DateTime?
  runs               LabExperimentRun[]
  releaseDecisions  LabReleaseDecision[]

  @@index([datasetId, createdAt])
  @@index([status, createdAt])
  @@map("lab_experiments")
}

model LabExperimentRun {
  organizationId String @default("default-organization")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  @@index([organizationId])
  @@unique([id, organizationId])
  id           String        @id @default(cuid())
  experimentId String
  experiment   LabExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  runId        String
  run          LabRun        @relation(fields: [runId], references: [id], onDelete: Restrict)
  arm          LabExperimentArm

  @@unique([experimentId, runId])
  @@index([experimentId, arm])
  @@map("lab_experiment_runs")
}

model LabReleaseDecision {
  organizationId String @default("default-organization")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  @@index([organizationId])
  @@unique([id, organizationId])
  id                 String          @id @default(cuid())
  agentVersionId     String
  agentVersion       LabAgentVersion @relation(fields: [agentVersionId], references: [id], onDelete: Restrict)
  datasetId          String
  dataset            LabDataset      @relation(fields: [datasetId], references: [id], onDelete: Restrict)
  runId              String?
  run                LabRun?         @relation(fields: [runId], references: [id], onDelete: SetNull)
  experimentId       String?
  experiment         LabExperiment?  @relation(fields: [experimentId], references: [id], onDelete: SetNull)
  decision           LabReleaseDecisionStatus
  thresholdSnapshot  Json
  metricsSnapshot    Json
  rationale          String
  approvedBy         String
  createdAt          DateTime        @default(now())

  @@index([agentVersionId, createdAt])
  @@index([decision, createdAt])
  @@map("lab_release_decisions")
}

model LabOperationLog {
  organizationId String @default("default-organization")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  @@index([organizationId])
  @@unique([id, organizationId])
  id         String              @id @default(cuid())
  actorId    String
  action     LabOperationAction
  objectType LabOperationObject
  objectId   String
  outcome    LabOperationOutcome
  createdAt  DateTime            @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([objectType, objectId])
  @@index([outcome, createdAt])
  @@map("lab_operation_logs")
}

model Workspace {
  organizationId String @default("default-organization")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  @@index([organizationId])
  @@unique([id, organizationId])
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  ownerId   String
  owner     User     @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members WorkspaceMember[]
  agents  Agent[]
  runs    Run[]
  datasets       EvaluationDataset[]
  evaluators     Evaluator[]
  evaluationRuns AgentEvaluationRun[]
  applications   Application[]

  @@index([ownerId])
  @@map("workspaces")
}

model WorkspaceMember {
  organizationId String @default("default-organization")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  @@index([organizationId])
  @@unique([id, organizationId])
  id          String          @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole  @default(OWNER)
  createdAt   DateTime        @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

enum WorkspaceRole {
  OWNER
  MEMBER
}

model Agent {
  organizationId String @default("default-organization")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  @@index([organizationId])
  @@unique([id, organizationId])
  id               String      @id @default(cuid())
  workspaceId      String
  key              String
  name             String
  description      String?     @db.Text
  type             String
  status           AgentStatus @default(DRAFT)
  currentVersionId String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  workspace      Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  versions       AgentVersion[] @relation("AgentVersions")
  currentVersion AgentVersion?  @relation("CurrentAgentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  runs           Run[]
  evaluationRuns AgentEvaluationRun[]
  applications   Application[]
  decisionRecords DecisionRecord[]

  @@unique([workspaceId, key])
  @@index([workspaceId, updatedAt])
  @@map("agents")
}

model AgentVersion {
  organizationId String @default("default-organization")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  @@index([organizationId])
  @@unique([id, organizationId])
  id               String             @id @default(cuid())
  agentId          String
  version          String
  status           AgentVersionStatus @default(DRAFT)
  modelConfig      Json?
  systemPrompt     String             @default("") @db.Text
  runtimeConfig    Json?
  toolBindings     Json?
  knowledgeBindings Json?
  memoryBindings   Json?
  inputSchema      Json?
  outputSchema     Json?
  changelog        String?            @db.Text
  createdAt        DateTime           @default(now())
  publishedAt      DateTime?

  currentForAgents Agent[] @relation("CurrentAgentVersion")
  parentAgent      Agent   @relation("AgentVersions", fields: [agentId], references: [id], onDelete: Cascade)
  runs             Run[]
  evaluationRuns  AgentEvaluationRun[]
  decisionRecords DecisionRecord[]

  @@unique([agentId, version])
  @@index([agentId, createdAt])
  @@map("agent_versions")
}

enum AgentStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum AgentVersionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Run {
  organizationId String @default("default-organization")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  @@index([organizationId])
  @@unique([id, organizationId])
  id             String    @id @default(cuid())
  workspaceId    String
  agentId        String
  agentVersionId String
  application    String?
  externalRunId  String?
  parentRunId    String?
  input          Json
  output         Json?
  status         RunStatus @default(PENDING)
  latencyMs      Int?
  tokenUsage     Json?
  estimatedCost  Float?
  error          String?   @db.Text
  budget         Json?
  traceSequence  Int       @default(0)
  createdAt      DateTime  @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  cancelRequestedAt DateTime?

  workspace      Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent          Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentVersion   AgentVersion @relation(fields: [agentVersionId], references: [id], onDelete: Restrict)
  parentRun      Run?         @relation("RunChildren", fields: [parentRunId], references: [id], onDelete: SetNull)
  childRuns      Run[]        @relation("RunChildren")
  traceEvents    TraceEvent[]
  evaluationResults EvaluationResult[]
  toolApprovals ToolApproval[]
  applicationRuns ApplicationRun[]

  @@index([workspaceId, createdAt])
  @@index([agentId, createdAt])
  @@index([agentVersionId, createdAt])
  @@index([externalRunId])
  @@index([parentRunId, createdAt])
  @@map("runs")
}

model TraceEvent {
  organizationId String @default("default-organization")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  @@index([organizationId])
  @@unique([id, organizationId])
  id            String   @id @default(cuid())
  formatVersion Int      @default(1)
  runId         String
  seq           Int      @map("sequence")
  turnId        String?
  step          String?
  callId        String?
  type          String
  name          String
  modelVisible  Boolean  @default(false)
  payload       Json?
  input         Json?
  output        Json?
  metadata      Json?
  latencyMs     Int?
  tokenUsage    Json?
  estimatedCost Float?
  error         String?  @db.Text
  createdAt     DateTime @default(now())

  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, seq])
  @@index([runId, seq])
  @@index([runId, callId])
  @@map("trace_events")
}

enum DecisionDomain {
  INTERVIEW
  AGENT_LAB
}

// 追加式决策账本：记录一次决定在何时、基于哪些输入和哪版规则得出。
model DecisionRecord {
  organizationId String @default("default-organization")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  @@index([organizationId])
  @@unique([id, organizationId])
  id             String         @id @default(cuid())
  domain         DecisionDomain
  decisionType   String
  subjectType    String
  subjectId      String
  outcome        Json
  ruleSetVersion String
  inputSnapshot  Json
  inputHash      String
  effectiveAt    DateTime       @default(now())
  recordedAt     DateTime       @default(now())
  actorId        String?
  interviewId    String?
  agentId        String?
  agentVersionId String?

  interview    Interview?    @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  agent        Agent?        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentVersion AgentVersion? @relation(fields: [agentVersionId], references: [id], onDelete: SetNull)
  facts        FactAssertion[]
  evidence     DecisionEvidence[]

  @@index([domain, subjectType, subjectId, recordedAt])
  @@index([interviewId, recordedAt])
  @@index([agentVersionId, recordedAt])
  @@map("decision_records")
}

// 一条事实永不覆盖；失效或撤销以新的反向 assertion 表达，支持按时间重放。
model FactAssertion {
  organizationId String @default("default-organization")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  @@index([organizationId])
  @@unique([id, organizationId])
  id         String   @id @default(cuid())
  decisionId String
  subjectType String
  subjectId  String
  predicate  String
  value      Json
  polarity   Boolean  @default(true)
  validFrom  DateTime @default(now())
  validTo    DateTime?
  sourceType String?
  sourceId   String?
  recordedAt DateTime @default(now())

  decision DecisionRecord @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  @@index([decisionId])
  @@index([subjectType, subjectId, predicate, validFrom])
  @@map("fact_assertions")
}

model DecisionEvidence {
  organizationId String @default("default-organization")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  @@index([organizationId])
  @@unique([id, organizationId])
  id         String   @id @default(cuid())
  decisionId String
  kind       String
  sourceType String
  sourceId   String?
  payload    Json?
  contentHash String?
  createdAt  DateTime @default(now())

  decision DecisionRecord @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  @@index([decisionId, createdAt])
  @@index([sourceType, sourceId])
  @@map("decision_evidence")
}

enum RunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum ApplicationStatus {
  ACTIVE
  ARCHIVED
}

model Application {
  organizationId String @default("default-organization")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  @@index([organizationId])
  @@unique([id, organizationId])
  id          String            @id @default(cuid())
  workspaceId String
  agentId     String
  key         String
  name        String
  type        String
  status      ApplicationStatus @default(ACTIVE)
  config      Json?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent     Agent            @relation(fields: [agentId], references: [id], onDelete: Restrict)
  runs      ApplicationRun[]

  @@unique([workspaceId, key])
  @@index([workspaceId, updatedAt])
  @@index([agentId])
  @@map("applications")
}

model ApplicationRun {
  organizationId String @default("default-organization")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  @@index([organizationId])
  @@unique([id, organizationId])
  id             String   @id @default(cuid())
  applicationId  String
  runId          String   @unique
  externalSessionId String?
  turn           Int?
  createdAt      DateTime @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  run         Run         @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
  @@index([externalSessionId, createdAt])
  @@map("application_runs")
}

enum ToolApprovalStatus {
  PENDING
  APPROVED
  DENIED
  CANCELLED
  TIMED_OUT
  ERROR
}

model ToolApproval {
  organizationId String @default("default-organization")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  @@index([organizationId])
  @@unique([id, organizationId])
  id             String             @id @default(cuid())
  runId          String
  callId         String
  toolName       String
  status         ToolApprovalStatus @default(PENDING)
  request        Json
  decision       Json?
  requestedAt    DateTime           @default(now())
  resolvedAt     DateTime?

  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, callId])
  @@index([runId, status])
  @@map("tool_approvals")
}

model EvaluationDataset {
  organizationId String @default("default-organization")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  @@index([organizationId])
  @@unique([id, organizationId])
  id          String   @id @default(cuid())
  workspaceId String
  key         String
  name        String
  description String?  @db.Text
  version     String   @default("1.0.0")
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  cases          EvaluationCase[]
  evaluationRuns AgentEvaluationRun[]

  @@unique([workspaceId, key])
  @@index([workspaceId, updatedAt])
  @@map("evaluation_datasets")
}

model EvaluationCase {
  organizationId String @default("default-organization")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  @@index([organizationId])
  @@unique([id, organizationId])
  id             String   @id @default(cuid())
  datasetId      String
  key            String
  input          Json
  expectedOutput Json?
  metadata       Json?
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  dataset EvaluationDataset  @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  results EvaluationResult[]

  @@unique([datasetId, key])
  @@index([datasetId, enabled])
  @@map("evaluation_dataset_cases")
}

enum EvaluatorType {
  KEYWORD
  JSON_SCHEMA
  LATENCY
}

model Evaluator {
  organizationId String @default("default-organization")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  @@index([organizationId])
  @@unique([id, organizationId])
  id          String        @id @default(cuid())
  workspaceId String
  key         String
  name        String
  type        EvaluatorType
  config      Json?
  enabled     Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  evaluationRuns AgentEvaluationRun[]

  @@unique([workspaceId, key])
  @@index([workspaceId, updatedAt])
  @@map("evaluators")
}

enum EvaluationStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model AgentEvaluationRun {
  organizationId String @default("default-organization")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  @@index([organizationId])
  @@unique([id, organizationId])
  id             String           @id @default(cuid())
  workspaceId    String
  agentId        String
  agentVersionId String
  datasetId      String
  evaluatorId    String
  status         EvaluationStatus @default(PENDING)
  score          Float?
  totalCases     Int              @default(0)
  passedCases    Int              @default(0)
  failedCases    Int              @default(0)
  metrics        Json?
  error          String?          @db.Text
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime         @default(now())

  workspace Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent     Agent                 @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentVersion AgentVersion       @relation(fields: [agentVersionId], references: [id], onDelete: Restrict)
  dataset   EvaluationDataset     @relation(fields: [datasetId], references: [id], onDelete: Restrict)
  evaluator Evaluator             @relation(fields: [evaluatorId], references: [id], onDelete: Restrict)
  results   EvaluationResult[]

  @@index([workspaceId, createdAt])
  @@index([agentId, createdAt])
  @@index([agentVersionId, createdAt])
  @@map("agent_evaluation_runs")
}

enum EvaluationCaseStatus {
  COMPLETED
  FAILED
}

model EvaluationResult {
  organizationId String @default("default-organization")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  @@index([organizationId])
  @@unique([id, organizationId])
  id            String               @id @default(cuid())
