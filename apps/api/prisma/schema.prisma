generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  passwordHash String?
  role      UserRole @default(USER)
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  interviews      Interview[]
  reflectionLogs  ReflectionLog[]
  targetJobs      TargetJob[]
  candidateSkillStates CandidateSkillState[]
  trainingRecommendations TrainingRecommendation[]
  trainingAttempts TrainingAttempt[]

  @@map("users")
}

enum UserRole {
  USER
  ADMIN
}

model Interview {
  id              String          @id @default(cuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  position        String // 岗位，如"前端开发"
  level           String          @default("P5") // 职级
  mode            InterviewMode   @default(FULL_SIMULATION)
  status          InterviewStatus @default(IN_PROGRESS)
  startedAt       DateTime        @default(now())
  endedAt         DateTime?
  summary         String? // 面试总结（AI 生成）
  resumeConfirmed Boolean         @default(false) // 用户是否确认过简历（false = 仍显示确认面板）
  targetJobId     String?
  targetJob       TargetJob? @relation(fields: [targetJobId], references: [id], onDelete: SetNull)
  targetJobProfileVersion Int?
  practiceSkillId String?
  practiceSkill   SkillDefinition? @relation("PracticeInterviewSkill", fields: [practiceSkillId], references: [id], onDelete: SetNull)

  messages       Message[]
  report         Report?
  cost           SessionCost?
  tasks          InterviewTask[]
  answerHistories AnswerHistory[]
  reflectionLogs ReflectionLog[]
  questions      InterviewQuestion[]
  answers        InterviewAnswer[]
  evaluationRuns EvaluationRun[]
  assessmentEvidence AssessmentEvidence[]
  trainingAttempt TrainingAttempt? @relation("TrainingRetestInterview")

  @@index([userId, startedAt])
  @@map("interviews")
}

/// 会话级成本面板（P0 缓存工程）
/// 每场 interview 一行，累加式写入（llm.call 钩子 + 终态结算）
model SessionCost {
  id          String    @id @default(cuid())
  interviewId String    @unique
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  // === 基础计数 ===
  llmCalls              Int @default(0) // 总 LLM 调用次数
  totalPromptTokens     Int @default(0) // 累计 prompt tokens
  totalCompletionTokens Int @default(0) // 累计 completion tokens
  totalTokens           Int @default(0) // = prompt + completion

  // === 缓存命中 ===
  promptCacheHits     Int @default(0) // Prompt Cache 命中次数（顶层 cache hit）
  promptCacheMisses   Int @default(0) // Prompt Cache 未命中次数
  cachedTokens        Int @default(0) // 实际被缓存命中的 token 数（来自 provider usage）
  semanticCacheHits   Int @default(0) // 语义缓存命中次数
  semanticCacheMisses Int @default(0) // 语义缓存未命中次数
  cacheSavedTokens    Int @default(0) // 通过缓存节省的 token（估算）

  // === 鲁棒性 ===
  retries   Int @default(0) // 重试次数
  fallbacks Int @default(0) // 降级到 fallback provider 的次数
  errors    Int @default(0) // 错误次数

  // === 成本（CNY，按 1k tokens 单价） ===
  inputCostPer1k   Float @default(0) // 输入 token 单价（CNY / 1k）
  outputCostPer1k  Float @default(0) // 输出 token 单价
  cacheDiscount    Float @default(0.4) // 缓存折扣（Qwen 0.4，DeepSeek 0.1）
  estimatedCostCny Float @default(0) // 估算总成本（元）

  // === 时间 ===
  startedAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  endedAt   DateTime?

  @@index([interviewId])
  @@map("session_costs")
}

model Message {
  id               String    @id @default(cuid())
  interviewId      String
  interview        Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  role             String // 'system' | 'user' | 'assistant' | 'tool'
  content          String    @db.Text
  clientMessageId  String?   @unique
  replyToMessageId String?   @unique
  replyToMessage   Message?  @relation("MessageReply", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replyMessage     Message?  @relation("MessageReply")
  metadata         Json? // 工具调用、token 消耗等
  promptTokens     Int       @default(0)
  completionTokens Int       @default(0)
  createdAt        DateTime  @default(now())
  interviewAnswer  InterviewAnswer?

  @@index([interviewId, createdAt])
  @@index([interviewId, clientMessageId])
  @@map("messages")
}

model Report {
  id           String    @id @default(cuid())
  interviewId  String    @unique
  interview    Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  currentEvaluationRunId String? @unique
  currentEvaluationRun EvaluationRun? @relation("ReportCurrentEvaluationRun", fields: [currentEvaluationRunId], references: [id], onDelete: SetNull)
  overallScore Int // 总分 0-100
  scores       Json // 多维度评分：技术、表达、逻辑
  strengths    String    @db.Text // 优点
  weaknesses   String    @db.Text // 不足
  suggestions  String    @db.Text // 改进建议
  createdAt    DateTime  @default(now())

  @@map("reports")
}

enum InterviewStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum InterviewMode {
  FULL_SIMULATION
  SKILL_PRACTICE
}

// 用户级 MCP 工具偏好：用户可独立开关每个工具
// 商用项目"工具治理"的体现
model UserToolPreference {
  id        String   @id @default(cuid())
  userId    String // email 桥接 demo user（与 User.email 形式一致）
  toolName  String // McpRegistry 的 name
  enabled   Boolean  @default(true)
  config    Json? // per-tool 配置（如 max_results、temperature 等，未来扩展）
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, toolName])
  @@index([userId])
  @@map("user_tool_preferences")
}

// 动态任务队列 - 面试过程中生成的问题队列
model InterviewTask {
  id        String    @id @default(cuid())
  interviewId String
  interview  Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  type      TaskType  // question | follow-up | summary | evaluation
  question  String    @db.Text
  category  String
  difficulty String   // easy | medium | hard
  priority  Int       @default(0)
  context   Json?     // 额外上下文信息
  status    TaskStatus @default(PENDING)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  questionRecord InterviewQuestion?

  @@index([interviewId, status, priority])
  @@map("interview_tasks")
}

// 答案历史 - 记录面试中的问答及评分
model AnswerHistory {
  id            String    @id @default(cuid())
  interviewId   String
  interview     Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  question      String    @db.Text
  answer        String    @db.Text
  score         Float     @default(0)      // 0-1
  completeness  Float     @default(0)     // 完整性 0-1
  correctness   Float     @default(0)     // 正确性 0-1
  depth         Float     @default(0)     // 深度 0-1
  feedback      String?   @db.Text        // 反馈建议
  llmEvaluated  Boolean   @default(false) // 是否由 LLM 评分
  questionId    String?
  questionRecord InterviewQuestion? @relation(fields: [questionId], references: [id], onDelete: SetNull)
  answerId      String?   @unique
  answerRecord  InterviewAnswer? @relation(fields: [answerId], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())

  @@index([interviewId])
  @@index([questionId])
  @@index([answerId])
  @@map("answer_histories")
}

model TargetJob {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  level       String?
  isActive    Boolean  @default(false)
  source      String   @default("manual")
  profileVersion Int   @default(1)
  company     String?
  jobDescription String? @db.Text
  jobDescriptionHash String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  candidateSkillStates CandidateSkillState[]
  skillRequirements JobSkillRequirement[]
  interviews      Interview[]
  trainingRecommendations TrainingRecommendation[]

  @@index([userId, updatedAt])
  @@index([userId, isActive])
  @@map("target_jobs")
}

model SkillDefinition {
  id              String   @id @default(cuid())
  slug            String
  name            String
  parentId        String?
  parent          SkillDefinition? @relation("SkillHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children        SkillDefinition[] @relation("SkillHierarchy")
  taxonomyVersion String
  applicableRoles String[]
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  questions      InterviewQuestion[]
  assessmentEvidence AssessmentEvidence[]
  candidateSkillStates CandidateSkillState[]
  jobRequirements JobSkillRequirement[]
  practiceInterviews Interview[] @relation("PracticeInterviewSkill")
  trainingRecommendations TrainingRecommendation[]

  @@unique([slug, taxonomyVersion])
  @@index([taxonomyVersion, isActive])
  @@map("skill_definitions")
}

model JobSkillRequirement {
  id             String   @id @default(cuid())
  targetJobId    String
  targetJob      TargetJob @relation(fields: [targetJobId], references: [id], onDelete: Cascade)
  skillId        String
  skill          SkillDefinition @relation(fields: [skillId], references: [id], onDelete: Restrict)
  importance     Int      @default(3)
  expectedLevel  String?
  source         String
  matchedTerms   Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([targetJobId, skillId])
  @@index([targetJobId, importance])
  @@map("job_skill_requirements")
}

model InterviewQuestion {
  id             String   @id @default(cuid())
  interviewId    String
  interview      Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  sourceTaskId   String?  @unique
  sourceTask     InterviewTask? @relation(fields: [sourceTaskId], references: [id], onDelete: SetNull)
  parentQuestionId String?
  parentQuestion InterviewQuestion? @relation("QuestionFollowUp", fields: [parentQuestionId], references: [id], onDelete: SetNull)
  followUpQuestions InterviewQuestion[] @relation("QuestionFollowUp")
  skillId        String?
  skill          SkillDefinition? @relation(fields: [skillId], references: [id], onDelete: SetNull)
  subSkill       String?
  externalQuestionId String?
  version        Int      @default(1)
  question       String   @db.Text
  category       String
  difficulty     String
  expectedEvidence Json?
  followUpPurpose String?
  selectionMetadata Json?
  source         String
  createdAt      DateTime @default(now())

  answers        InterviewAnswer[]
  answerHistories AnswerHistory[]
  assessmentEvidence AssessmentEvidence[]

  @@index([interviewId, createdAt])
  @@index([skillId])
  @@index([parentQuestionId])
  @@map("interview_questions")
}

model InterviewAnswer {
  id             String   @id @default(cuid())
  interviewId    String
  interview      Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  questionId     String
  question       InterviewQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)
  messageId      String   @unique
  message        Message  @relation(fields: [messageId], references: [id], onDelete: Restrict)
  content        String   @db.Text
  revision       Int      @default(1)
  createdAt      DateTime @default(now())

  answerHistories AnswerHistory[]
  assessmentEvidence AssessmentEvidence[]

  @@index([interviewId, createdAt])
  @@index([questionId])
  @@map("interview_answers")
}

model EvaluationDefinition {
  id                    String   @id @default(cuid())
  version               String   @unique
  definitionHash        String   @unique
  evaluatorVersion      String
  promptVersion         String
  rubricVersion         String
  modelProvider         String
  modelVersion          String
  modelParameters       Json?
  evaluationMode        EvaluationMode
  fallbackPolicyVersion String
  createdAt             DateTime @default(now())

  evaluationRuns EvaluationRun[]

  @@index([evaluationMode, createdAt])
  @@map("evaluation_definitions")
}

model EvaluationRun {
  id                   String   @id @default(cuid())
  interviewId          String
  interview            Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  definitionId         String
  definition           EvaluationDefinition @relation(fields: [definitionId], references: [id], onDelete: Restrict)
  inputRevision        String
  mode                 EvaluationMode
  status               EvaluationRunStatus @default(PENDING)
  idempotencyKey       String   @unique
  reportPayload        Json?
  error                String?  @db.Text
  degradedReason       String?  @db.Text
  supersedesId         String?
  supersedes           EvaluationRun? @relation("EvaluationRunSupersedes", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy         EvaluationRun[] @relation("EvaluationRunSupersedes")
  createdAt            DateTime @default(now())
  completedAt          DateTime?

  assessmentEvidence   AssessmentEvidence[]
  reportSnapshots      Report[] @relation("ReportCurrentEvaluationRun")
  candidateSkillStates CandidateSkillState[]
  trainingRecommendations TrainingRecommendation[]

  @@unique([interviewId, inputRevision, definitionId, mode])
  @@index([interviewId, createdAt])
  @@index([status, createdAt])
  @@map("evaluation_runs")
}

model AssessmentEvidence {
  id                   String   @id @default(cuid())
  evaluationRunId      String
  evaluationRun        EvaluationRun @relation(fields: [evaluationRunId], references: [id], onDelete: Cascade)
  interviewId          String
  interview            Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  questionId           String
  question             InterviewQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)
  answerId             String
  answer               InterviewAnswer @relation(fields: [answerId], references: [id], onDelete: Restrict)
  skillId              String?
  skill                SkillDefinition? @relation(fields: [skillId], references: [id], onDelete: SetNull)
  answerExcerpt        String   @db.Text
  expectedEvidence     Json?
  observedEvidence     Json?
  dimensions           Json?
  score                Float?
  reason               String?  @db.Text
  missingEvidence      Json?
  recommendation       String?  @db.Text
  confidence           Float    @default(0)
  version              Int      @default(1)
  createdAt            DateTime @default(now())

  trainingRecommendations TrainingRecommendation[]

  @@unique([evaluationRunId, answerId])
  @@index([interviewId, createdAt])
  @@index([skillId, createdAt])
  @@map("assessment_evidence")
}

model CandidateSkillState {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetJobId     String
  targetJob       TargetJob @relation(fields: [targetJobId], references: [id], onDelete: Cascade)
  skillId         String
  skill           SkillDefinition @relation(fields: [skillId], references: [id], onDelete: Restrict)
  score           Float
  confidence      Float
  trend           Float?
  evidenceCount   Int      @default(0)
  lastAssessedAt  DateTime
  sourceRunId     String?
  sourceRun       EvaluationRun? @relation(fields: [sourceRunId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, targetJobId, skillId])
  @@index([userId, lastAssessedAt])
  @@index([sourceRunId])
  @@map("candidate_skill_states")
}

model TrainingRecommendation {
  id                      String   @id @default(cuid())
  userId                  String
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetJobId             String
  targetJob               TargetJob @relation(fields: [targetJobId], references: [id], onDelete: Cascade)
  targetJobProfileVersion Int
  skillId                 String
  skill                   SkillDefinition @relation(fields: [skillId], references: [id], onDelete: Restrict)
  sourceRunId             String
  sourceRun               EvaluationRun @relation(fields: [sourceRunId], references: [id], onDelete: Restrict)
  sourceEvidenceId        String
  sourceEvidence          AssessmentEvidence @relation(fields: [sourceEvidenceId], references: [id], onDelete: Restrict)
  evidenceIds             Json
  objective               String   @db.Text
  prompts                 Json
  expectedEvidence        Json
  status                  TrainingRecommendationStatus @default(READY)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  attempts TrainingAttempt[]

  @@unique([userId, targetJobId, skillId, sourceRunId])
  @@index([userId, targetJobId, status])
  @@map("training_recommendations")
}

model TrainingAttempt {
  id               String   @id @default(cuid())
  recommendationId String
  recommendation   TrainingRecommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status           TrainingAttemptStatus @default(COMPLETED)
  completedAt      DateTime @default(now())
  retestInterviewId String? @unique
  retestInterview   Interview? @relation("TrainingRetestInterview", fields: [retestInterviewId], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now())

  @@index([userId, completedAt])
  @@map("training_attempts")
}

// ADR #10 Phase 1：Reviewer 反思日志
// 每次 reviewer 节点执行时记录一次，用于：
//   - Layer 1: 短期内给 planner 注入 reflection
//   - Layer 2: cron 聚合高频 issue_tags，定位系统弱点
model ReflectionLog {
  id            String   @id @default(cuid())
  interviewId   String
  interview     Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question      String   @db.Text
  finalResponse String   @db.Text
  reviewScore   Float    // 0-1
  reviewIssues  String[] // 自由文本 issues 列表
  issueTags     String[] // 结构化标签 (factual_error / incomplete / hallucination ...)
  reflection    String?  @db.Text // 自我反思文本
  retryCount    Int      @default(0)
  hitlPending   Boolean  @default(false)
  modelName     String   // qwen-plus / deepseek-chat
  nodeName      String   @default("reviewer") // 未来扩展支持其他节点
  createdAt     DateTime @default(now())

  @@index([interviewId])
  @@index([userId])
  @@index([createdAt])
  @@index([reviewScore])
  @@index([issueTags], type: Gin)
  @@map("reflection_logs")
}

enum TaskType {
  QUESTION
  FOLLOW_UP
  SUMMARY
  EVALUATION
}

enum TaskStatus {
  PENDING
  COMPLETED
  SKIPPED
}

enum EvaluationMode {
  FINAL
  PRACTICE
  PREVIEW
}

enum EvaluationRunStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  DEGRADED
  SUPERSEDED
}

enum TrainingRecommendationStatus {
  READY
  COMPLETED
  RETEST_STARTED
}

enum TrainingAttemptStatus {
  COMPLETED
}
