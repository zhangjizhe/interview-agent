// ADR #10 Phase 1：Reviewer 反思日志
// 每次 reviewer 节点执行时记录一次，用于：
//   - Layer 1: 短期内给 planner 注入 reflection
//   - Layer 2: cron 聚合高频 issue_tags，定位系统弱点
model ReflectionLog {
  organizationId String @default("default-organization")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  @@index([organizationId])
  @@unique([id, organizationId])
  id            String   @id @default(cuid())
  interviewId   String
  interview     Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question      String   @db.Text
  finalResponse String   @db.Text
  reviewScore   Float    // 0-1
  reviewIssues  String[] // 自由文本 issues 列表
  issueTags     String[] // 结构化标签 (factual_error / incomplete / hallucination ...)
  reflection    String?  @db.Text // 自我反思文本
  retryCount    Int      @default(0)
  hitlPending   Boolean  @default(false)
  modelName     String   // qwen-plus / deepseek-chat
  nodeName      String   @default("reviewer") // 未来扩展支持其他节点
  createdAt     DateTime @default(now())

  @@index([interviewId])
  @@index([userId])
  @@index([createdAt])
  @@index([reviewScore])
  @@index([issueTags], type: Gin)
  @@map("reflection_logs")
}

