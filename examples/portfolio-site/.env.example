# 默认使用 Agent Lab；不配置时明确返回未启用，不会回退到直连模型。
ASSISTANT_MODE=agent-lab
AGENT_LAB_BASE_URL=http://127.0.0.1:3001/api
AGENT_LAB_PUBLIC_ORIGIN=http://127.0.0.1:8787
# 远程部署必须为 HTTPS，Lab 需允许上面的站点 Origin。
# AGENT_LAB_BASE_URL=https://your-lab-api.example/api
# AGENT_LAB_PUBLIC_ORIGIN=https://your-portfolio.example

# 仅保留旧协议兼容测试/私有开发；要使用必须显式设置 ASSISTANT_MODE=direct。
# 不可把旧直连模式当成已经通过 Lab 围栏与预算验收。
# MODEL_BASE_URL=https://your-provider.example/v1
# MODEL_NAME=your-tool-capable-model
# MODEL_API_KEY=replace-with-server-side-key
PORT=8787
HOST=127.0.0.1
