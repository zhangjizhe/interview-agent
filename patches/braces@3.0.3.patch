diff --git a/lib/validate-ast.js b/lib/validate-ast.js
new file mode 100644
index 0000000000000000000000000000000000000000..29f961239ee22258291f7059cc56e351f9ddedf2
--- /dev/null
+++ b/lib/validate-ast.js
@@ -0,0 +1,28 @@
+'use strict';
+
+// GHSA-vfj7-8cjw-p6xm: AST callers bypass parse(), so validate iteratively
+// before any recursive walker. Parent backlinks in parsed ASTs are intentional.
+module.exports = ast => {
+  const active = new WeakSet();
+  const stack = [{ node: ast, depth: 0, exit: false }];
+  let visited = 0;
+  while (stack.length) {
+    const { node, depth, exit } = stack.pop();
+    if (!node || typeof node !== 'object') throw new SyntaxError('Invalid brace AST');
+    if (exit) { active.delete(node); continue; }
+    if (active.has(node)) throw new SyntaxError('Cyclic brace AST');
+    // A leaf under 32 nested blocks is at depth 33 (root at zero).
+    if (depth > 33) throw new SyntaxError('Brace pattern exceeds maximum nesting depth (32)');
+    if (++visited > 20000) throw new SyntaxError('Brace AST exceeds maximum node count (20000)');
+    active.add(node);
+    stack.push({ node, depth, exit: true });
+    if (node.nodes) {
+      if (!Array.isArray(node.nodes)) throw new SyntaxError('Invalid brace AST nodes');
+      // Bound work before copying a hostile, extremely wide nodes array.
+      if (node.nodes.length > 20000) throw new SyntaxError('Brace AST exceeds maximum node count (20000)');
+      for (let i = node.nodes.length - 1; i >= 0; i--) {
+        stack.push({ node: node.nodes[i], depth: depth + 1, exit: false });
+      }
+    }
+  }
+};
